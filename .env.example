# PostgreSQL (used by docker-compose)
POSTGRES_USER=scoreboard
POSTGRES_PASSWORD=scoreboard_pass
POSTGRES_DB=scoreboard_db

# Backend — direct connection URL (used when running pnpm dev locally)
DATABASE_URL=postgresql://scoreboard:scoreboard_pass@localhost:5432/scoreboard_db

# Backend
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# Frontend (Next.js public env — baked at build time)
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000
